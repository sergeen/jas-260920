<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/dialog_bg">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selector de Video (Local / USB)"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvCurrentPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ruta: /sdcard"
        android:textColor="@color/accent"
        android:textSize="13sp"
        android:layout_marginBottom="12dp"
        android:ellipsize="start"
        android:singleLine="true" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFileList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"
        tools:listitem="@layout/item_file" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btnDefaultPath"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Restablecer a /sdcard/Movies/video.mp4"
            android:textColor="@color/white"
            android:background="@drawable/selector_item_focus"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginEnd="12dp"
            android:focusable="true" />

        <Button
            android:id="@+id/btnCancelPicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cerrar"
            android:textColor="@color/white"
            android:background="@drawable/selector_item_focus"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
