<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0D47A1"
                android:endColor="#1565C0"
                android:angle="45" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item
        android:top="20dp"
        android:bottom="20dp"
        android:left="20dp"
        android:right="20dp">
        <vector
            android:width="280dp"
            android:height="140dp"
            android:viewportWidth="280"
            android:viewportHeight="140">
            <!-- Play icon inside screen -->
            <path
                android:fillColor="#FFFFFFFF"
                android:pathData="M120,45 L175,70 L120,95 Z" />
            <!-- Border box -->
            <path
                android:strokeColor="#80FFFFFF"
                android:strokeWidth="3"
                android:pathData="M30,20 L250,20 L250,120 L30,120 Z" />
        </vector>
    </item>
</layer-list>
